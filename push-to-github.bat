@echo off
echo Initializing Git repository...
git init
echo Adding files...
git add .
echo Creating commit...
git commit -m "Fix order placement resilience & push professional digital menu PWA"
echo Setting main branch...
git branch -M main
echo Setting remote URL...
git remote remove origin 2>nul
git remote add origin https://github.com/zeriouil/DelivriLi.git
echo Pushing to GitHub...
git push -u origin main
echo Done!
pause
